# Backend settings (Render environment variables / local backend/.env)
# Never commit real values. Keys live only in the server environment.

LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview URLs. Restrict it to YOUR project prefix, e.g.
# ALLOWED_ORIGIN_REGEX=^https://timetablesolver-[a-z0-9-]+-<team>\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

SOLVER_TIME_LIMIT_S=5
MAX_INPUT_CHARS=2000
DAILY_LLM_CALL_LIMIT=200
LOG_LEVEL=INFO
