# 서버(services/api) 환경 변수 예시. 실제 값은 절대 커밋하지 않는다.
# 실제 키는 services/api/.env(커밋 금지, `--env-file`로 읽음) 또는 셸 환경에만 둔다.
# 프론트(VITE_*)에는 비밀키를 절대 넣지 않는다.
# 이전 구현(main backend/)에서 이름이 바뀜: LLM_API_KEY→GEMINI_API_KEY, ALLOWED_ORIGINS→CORS_ORIGINS.
# main의 ALLOWED_ORIGIN_REGEX, SUPABASE_URL/KEY, SOLVER_TIME_LIMIT_S, MAX_INPUT_CHARS, DAILY_LLM_CALL_LIMIT, LOG_LEVEL은
# 현재 서버가 읽지 않으므로 넣지 않는다.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# 자연어 해석기: fixture(기본, 규칙 기반 데모 해석) | gemini(live)
LLM_PROVIDER=fixture
# LLM_PROVIDER=gemini 일 때만 사용. 모델 ID는 사용 시점에 공식 문서(https://aistudio.google.com/docs/models)에서 확인한 값을 넣는다(코드에 하드코딩하지 않음).
GEMINI_API_KEY=
LLM_MODEL=
ENABLE_DEMO_FIXTURES=1
SOLVER_CONCURRENCY=1
