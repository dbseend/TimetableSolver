# Backend settings (Render environment variables / local .env at repo root or backend/.env)
# Never commit real values. Keys live only in the server environment.

# gemini | none. Without LLM_API_KEY only the LLM features are disabled; the server still starts.
LLM_PROVIDER=gemini
# Low-cost stable model per https://aistudio.google.com/docs/models (checked 2026-11-09).
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview URLs. Restrict it to YOUR project prefix, e.g.
# ALLOWED_ORIGIN_REGEX=^https://timetablesolver-[a-z0-9-]+-<team>\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Supabase settings (PostgREST access to catalog data; see docs/adr/0005)
SUPABASE_URL=
SUPABASE_KEY=

SOLVER_TIME_LIMIT_S=5
MAX_INPUT_CHARS=2000
DAILY_LLM_CALL_LIMIT=200
LOG_LEVEL=INFO
